prefix=@REDISDAL_PREFIX@
exec_prefix=${prefix}
libdir=@REDISDAL_LIBDIR@
includedir=@REDISDAL_INCLUDEDIR@

Name: redisdal
Description: Redis helper library for C++ (redisdal)
Version: @REDISDAL_VERSION@
Requires:
Libs: -L${libdir} -lredisdal
Cflags: -I${includedir}

# Notes:
# - Both CMake and Meson supply the REDISDAL_* configuration variables.
# - Install the generated redisdal.pc into the configured libdir/pkgconfig.
